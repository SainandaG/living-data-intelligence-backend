VITE_API_URL=http://localhost:8001
VITE_WEBSOCKET_URL=ws://localhost:8001/ws

# Feature flags (set to 'true' to enable; all off by default)
# VITE_FEATURE_AGENT_CLASSES=true
# VITE_FEATURE_TYPED_HANDLERS=true
# VITE_FEATURE_EVENT_BUS=true
# VITE_FEATURE_ADVANCED_AUDIO=true
# VITE_FEATURE_SHADER_GLOW=true
# VITE_FEATURE_V2_ENDPOINTS=true
# VITE_FEATURE_BATCH_REQUESTS=true
# VITE_FEATURE_AGENT_DEBUG_PANEL=true
# VITE_FEATURE_PERFORMANCE_MONITORING=true

# Polling intervals in ms (defaults shown)
# VITE_AGENT_POLL_INTERVAL=10000
# VITE_METRICS_POLL_INTERVAL=5000
# VITE_VITALS_POLL_INTERVAL=5000
# VITE_INTELLIGENCE_POLL_INTERVAL=15000
# VITE_FORMATION_POLL_INTERVAL=2000
