# Server Configuration
PORT=8001
HOST=0.0.0.0
LOG_LEVEL=DEBUG

# Database Configuration (PostgreSQL Example)
DB_TYPE=postgresql
DB_HOST=your-db-host.neon.tech
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Security
CORS_ORIGINS=["http://localhost:8000","http://localhost:3000","http://localhost:5173"]
REFRESH_INTERVAL=5

# AI/ML Configuration
ENABLE_AI_CLASSIFICATION=true
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
JWT_SECRET_KEY=change-this-to-a-random-256-bit-secret
DISABLE_AUTH=false
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD_HASH=your_bcrypt_hashed_password_here
DEMO_MODE=true
ENABLE_TRAFFIC_SCORING=true
FIREBASE_SERVICE_ACCOUNT_KEY=/path/to/your/firebase-key.json
