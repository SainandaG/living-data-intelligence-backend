# ============================================
# LIVBAC — Environment Configuration
# ============================================
# Copy this file as .env and fill in real values.
# The app WILL NOT START without JWT_SECRET_KEY and GOOGLE_API_KEY.

# ---- Server ----
HOST=0.0.0.0
PORT=8001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Database (REQUIRED) ----
DB_TYPE=postgres
DB_HOST=your-database-host.com
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_username
DB_PASSWORD=your_password

# ---- Authentication (REQUIRED) ----
JWT_SECRET_KEY=change-this-to-a-random-64-char-string
# Set to true ONLY for local dev to skip JWT auth on all routes.
# Rejected in production (APP_ENV=production). Default: false (auth enforced).
DISABLE_AUTH=false

# ---- AI / LLM (at least one REQUIRED) ----
GOOGLE_API_KEY=your-google-api-key
GROQ_API_KEY=your-groq-api-key

# ---- Optional ----
ENABLE_AI_CLASSIFICATION=true
REFRESH_INTERVAL=5000

# ---- Feature Flags (optional — off by default) ----
# Enable improved NLP pipeline (set true when stable)
USE_NLP_V2=false
# Enable GNN-based inference — requires PyTorch (~2 GB download)
USE_GNN_INFERENCE=false
# Production env tag — triggers hard startup fail on missing secrets
APP_ENV=development

# ---- Notifications (optional — Decision Hub dispatch) ----
# Slack: Set SLACK_WEBHOOK_URL to enable Slack alerts
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#alerts

# Email: Set all four SMTP_* vars + ALERT_EMAIL_TO to enable email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Generic Webhook: Set WEBHOOK_URL to forward decisions as JSON POST
WEBHOOK_URL=
