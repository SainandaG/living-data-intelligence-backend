# ============================================
# Living Data Intelligence — Environment Configuration
# ============================================
# Copy this file as .env and fill in real values.
# The app requires JWT_SECRET_KEY and GOOGLE_API_KEY for full functionality.

# ---- Server ----
PORT=8001
HOST=0.0.0.0
LOG_LEVEL=DEBUG
# CORS_ORIGINS can be a comma-separated list or a JSON array
CORS_ORIGINS=["http://localhost:8000","http://localhost:3000","http://localhost:5173"]

# ---- Database (REQUIRED) ----
DB_TYPE=postgresql
DB_HOST=your-database-host.com
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_username
DB_PASSWORD=your_password

# ---- Security & Authentication ----
JWT_SECRET_KEY=change-this-to-a-random-256-bit-secret
# Set to true for local dev to skip JWT auth. 
# Reverts to false in production (APP_ENV=production).
DISABLE_AUTH=false

# Bootstrap Admin User (Initial login)
ADMIN_EMAIL=admin@livingdata.ai
# Hashed password (e.g., bcrypt hash of 'admin123')
ADMIN_PASSWORD_HASH=your-bcrypt-password-hash

# ---- AI / LLM Configuration ----
GOOGLE_API_KEY=your-google-api-key
GROQ_API_KEY=your-groq-api-key
ENABLE_AI_CLASSIFICATION=true

# ---- Operational Settings ----
REFRESH_INTERVAL=5
DEMO_MODE=false
APP_ENV=development

# ---- Redis Cache (Optional) ----
REDIS_URL=redis://localhost:6379

# ---- Notifications (Optional) ----
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
WEBHOOK_URL=
